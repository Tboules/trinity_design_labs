---
import getImage from "../utils/cloudinary";
---

<section class="bg-white">
  <div class="container mx-auto sm:p-0 p-5">
    <div
      class="flex flex-col items-center justify-between py-[150px] lg:flex-row"
    >
      <div class="max-w-[585px] lg:mb-0 mb-14">
        <p
          class="mb-3.5 text-center text-[24px] leading-[24px] font-medium uppercase sm:mb-5 sm:text-[40px] sm:leading-[60px] lg:text-start"
        >
          Contact Us
        </p>
        <p
          class="mb-10 text-center text-[38px] leading-[38px] font-medium sm:mb-11 sm:text-[56px] sm:leading-[60px] lg:text-start lg:text-[83px] lg:leading-[80px]"
        >
          We drive your business forward
        </p>
        <a
          href="tel:+13195550115"
          class="mb-[10px] flex items-center justify-center gap-2.5 sm:mb-[30px] lg:justify-start lg:gap-5"
        >
          <img src={getImage("headphone")} alt="" class="w-6 sm:w-auto" />
          <p class="text-[14px] font-medium sm:text-xl">(319) 555-0115</p>
        </a>
        <a
          href="mailto:hello@trinitydesignlab.com"
          class="flex items-center justify-center gap-2.5 lg:justify-start lg:gap-5"
        >
          <img src={getImage("mail")} alt="" class="w-6 sm:w-auto" />
          <p class="text-[14px] font-medium sm:text-xl">
            hello@trinitydesignlab.com
          </p>
        </a>
      </div>
      <div
        class="sm:w-[493px] w-full rounded-[40px] border border-[#8B8B8B] p-[30px] shadow-[0px_10px_0px_0px_#57C5C8] lg:mr-[50px]"
      >
        <form>
          <div class="mb-5">
            <label
              for="first_name"
              class="block text-[16px] leading-4 font-medium text-[#000000]"
              >Your Name</label
            >
            <input
              type="text"
              id="first_name"
              class="block w-full border-b border-gray-300 px-2.5 py-1.5 text-sm text-[#000000] focus:border-[#57C5C8] focus:outline-none"
              placeholder=""
              required
            />
          </div>
          <div class="mb-5">
            <label
              for="email"
              class="block text-[16px] leading-4 font-medium text-[#000000]"
              >Email</label
            >
            <input
              type="email"
              id="email"
              class="block w-full border-b border-gray-300 px-2.5 py-1.5 text-sm text-[#000000] focus:border-[#57C5C8] focus:outline-none"
              placeholder=""
              required
            />
          </div>
          <div class="mb-5">
            <label
              for="phone"
              class="block text-[16px] leading-4 font-medium text-[#000000]"
              >Phone Number</label
            >
            <input
              type="tel"
              id="phone"
              class="block w-full border-b border-gray-300 px-2.5 py-1.5 text-sm text-[#000000] focus:border-[#57C5C8] focus:outline-none"
              placeholder=""
              required
            />
          </div>
          <div class="mb-10">
            <label
              for="message"
              class="block text-[16px] leading-4 font-medium text-[#000000]"
              >Your Message</label
            >
            <textarea
              name="message"
              id="message"
              rows="4"
              class="block w-full border-b border-gray-300 px-2.5 py-1.5 text-sm text-[#000000] focus:border-[#57C5C8] focus:outline-none"
            ></textarea>
          </div>
          <div class="text-center">
            <button
              type="submit"
              class="mb-0 inline-flex items-center rounded-[12px] px-6 py-3 font-medium text-white transition-transform duration-200 hover:scale-105"
              style="background: linear-gradient(105.36deg, #70CCCF 0%, #8DB73E 50.03%, #4C9D31 100.06%);"
              >Leave us a Message<span class="ml-2 text-3xl">↗</span></button
            >
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
